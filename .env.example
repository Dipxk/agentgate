# Copy to .env and fill in. Never commit real keys.

# sqlite:///./.agentgate/agentgate.db is the default when this is unset.
# For Docker Compose:
# AGENTGATE_DATABASE_URL=postgresql+psycopg://agentgate:agentgate@db:5432/agentgate
AGENTGATE_DATABASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

AGENTGATE_API_URL=http://127.0.0.1:8000
AGENTGATE_CORS=http://localhost:3000,http://127.0.0.1:3000
